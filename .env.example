# Get these from the myenergi app (My Account > Advanced)
MYENERGI_HUB_SERIAL=sn-goes-here
MYENERGI_API_KEY=api-key-goes-here

# Optional: if you know your server already (e.g. s18)
# MYENERGI_SERVER=

# WhatsApp notifications via Callmebot (optional)
# See README for setup instructions
# Supports multiple recipients (comma-separated)
# CALLMEBOT_PHONE=+353861234567,+353869876543
# CALLMEBOT_API_KEY=apikey1,apikey2
